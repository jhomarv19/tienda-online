
# .gitignore

```gitignore
# Entorno virtual de Python
venv/
.env
.env.local
.env.*.local

# Archivos de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Archivos de configuración de PyInstaller
*.spec

# Archivos de base de datos
*.db
*.sqlite
*.sqlite3

# Archivos de log
*.log

# Archivos del sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Archivos del IDE
.vscode/
.idea/
*.swp
*.swo

# Archivos temporales
*.tmp
*~